{
  "$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",
  "slug": "dinkus-accounts",
  "publisher": "did:plc:ekk4pjmkh3k3ql2kfoex3qt4",
  "name": "DinkusKit Accounts",
  "description": "Shopper sign-in and saved addresses for DinkusKit Commerce stores on EmDash. Shoppers sign in with a 6-digit code sent by email.",
  "keywords": ["accounts", "customer accounts", "sign in", "ecommerce"],
  "license": "MIT",
  "author": {
    "name": "DinkusKit",
    "url": "https://dinkuskit.com"
  },
  "security": {
    "url": "https://github.com/dinkuskit/accounts/security"
  },
  "repo": "https://github.com/dinkuskit/accounts",
  "capabilities": ["email:send"],
  "storage": {
    "shoppers": { "indexes": [], "uniqueIndexes": [] },
    "sign_in_codes": { "indexes": ["expiresAt"], "uniqueIndexes": [] },
    "sessions": { "indexes": ["expiresAt"], "uniqueIndexes": [] }
  },
  "admin": {
    "pages": [
      { "path": "/accounts", "label": "Shopper accounts", "icon": "users" }
    ]
  }
}
